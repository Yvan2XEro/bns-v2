# MongoDB
MONGO_IMAGE=mongo:7
MONGO_USER=bns
MONGO_PASSWORD=changeme
MONGO_DB=bns
# Single-node replica set — required for multi-document transactions.
# Empty = standalone, and Payload silently disables transactions.
#
# Create the key file BEFORE enabling it: with no file there, Docker creates a
# root-owned mongo-keyfile *directory* and mongod crash-loops (cleanup needs sudo).
#   openssl rand -base64 756 > mongo-keyfile && chmod 400 mongo-keyfile
#   sudo chown 999:999 mongo-keyfile
# Then set both lines together — MONGO_REPLICA_SET without MONGO_KEYFILE_PATH
# mounts /dev/null and mongod dies on "permissions are too open", which does not
# look like a missing path. Compose cannot express that guard, hence this note.
#   MONGO_REPLICA_SET=rs0
#   MONGO_KEYFILE_PATH=./mongo-keyfile
# Finally initiate the set once (rs.initiate with host "mongodb:27017"); the full
# procedure is docs/superpowers/plans/2026-09-15-p0-mongo-replica-set-runbook.md.
MONGO_REPLICA_SET=
MONGO_KEYFILE_PATH=

# Redis
REDIS_PASSWORD=changeme

# Meilisearch
MEILI_MASTER_KEY=changeme-master-key
MEILI_ENV=production

# Payload CMS (API)
PAYLOAD_SECRET=changeme-payload-secret
PAYLOAD_PUBLIC_SERVER_URL=https://api.buynsellem.com
PAYLOAD_ALLOWED_ORIGINS=https://buynsellem.com,https://www.buynsellem.com

# Public domains used by docker-compose.yml Traefik labels and default URLs
WEB_DOMAIN=buynsellem.com
WEB_WWW_DOMAIN=www.buynsellem.com
API_DOMAIN=api.buynsellem.com
CHAT_DOMAIN=chat.buynsellem.com
DB_DOMAIN=db.buynsellem.com
# Reserved for a future public search route if exposed through Traefik
SEARCH_DOMAIN=search.buynsellem.com

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# NotchPay (boost payments — West Africa)
# Public key = Authorization header pour tous les appels API NotchPay
NOTCHPAY_PUBLIC_KEY=your-notchpay-public-key
NOTCHPAY_BASE_URL=https://api.notchpay.co

# Stripe (optional — enables card payments on web + Apple Pay on iOS)
# Leave blank to disable; system falls back to NotchPay for all platforms
# Publishable key is served at runtime via GET /api/public/config (no rebuild needed)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Novu (notifications)
NOVU_SECRET_KEY=your-novu-secret-key
NOVU_APPLICATION_IDENTIFIER=your-novu-app-id
NOVU_API_URL=https://api.novu.co
# Optional when you have multiple Expo push integrations in the same Novu environment
NOVU_EXPO_INTEGRATION_IDENTIFIER=

# Web frontend
CHAT_PUBLIC_URL=https://chat.buynsellem.com
PUBLIC_WEB_URL=https://buynsellem.com
NEXT_PUBLIC_WEB_URL=https://buynsellem.com

# Mongo Express (DB admin UI)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme

# CORS for chat-service
CORS_ORIGIN=https://buynsellem.com,https://www.buynsellem.com

# Chat service — dedicated Payload service account (used for internal API calls)
CHAT_SERVICE_EMAIL=chat-service@buynsellem.com
CHAT_SERVICE_PASSWORD=changeme

# GitHub repo (for prod images)
GITHUB_REPO=your-org/bns-repo

# --- For local / test network (no TLS) ---
# Use: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d
# And override these values in your .env:
#NEXT_PUBLIC_API_URL=http://api.buynsellem.com
#CHAT_PUBLIC_URL=http://chat.buynsellem.com
#PAYLOAD_ALLOWED_ORIGINS=http://buynsellem.com,http://www.buynsellem.com
#CORS_ORIGIN=http://buynsellem.com,http://www.buynsellem.com

# Storage
# Provider: local (default, no extra config) | s3 | azure
STORAGE_PROVIDER=local

# S3 / S3-compatible (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# S3_ENDPOINT=https://...  # optional — MinIO, Supabase Storage, Cloudflare R2, etc.

# Azure Blob Storage (when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_BASEURL=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false

# Private storage for identity documents (P2 verification) — must be a
# different bucket/container than the public media one above, or a document
# would be served from the public path. Read only under STORAGE_PROVIDER=s3
# or =azure respectively; local storage uses PRIVATE_UPLOADS_DIR on disk.
S3_PRIVATE_BUCKET=
AZURE_STORAGE_PRIVATE_CONTAINER_NAME=
PRIVATE_UPLOADS_DIR=private-uploads/verification

# Identity & business verification (P2) — Didit KYC
# VERIFICATION_HASH_PEPPER keys the document-number and reviewer-IP hashes.
# Required: with it empty, the API refuses to hash (fails closed) and both
# opening a document and processing a KYC webhook stop working. Rotating it
# orphans every existing hash, so duplicate detection restarts from that point.
VERIFICATION_HASH_PEPPER=changeme-verification-hash-pepper
# Staging only — lets verification be enabled before the legal authorisation
# is recorded below. No effect when NODE_ENV=production (hardcoded in the API
# Dockerfile), so this is safe to leave as-is anywhere else.
VERIFICATION_ALLOW_UNAUTHORISED=false
# Leave blank to disable identity verification (Didit); the rest of the app
# still works without it. Only needed to exercise the KYC flow end to end.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
