# MongoDB
MONGO_IMAGE=mongo:7
MONGO_USER=bns
MONGO_PASSWORD=changeme
MONGO_DB=bns

# Redis
REDIS_PASSWORD=changeme

# Meilisearch
MEILI_MASTER_KEY=changeme-master-key
MEILI_ENV=production

# Payload CMS (API)
PAYLOAD_SECRET=changeme-payload-secret
PAYLOAD_PUBLIC_SERVER_URL=https://api.buynsellem.com
PAYLOAD_ALLOWED_ORIGINS=https://buynsellem.com,https://www.buynsellem.com

# Public domains used by docker-compose.yml Traefik labels and default URLs
WEB_DOMAIN=buynsellem.com
WEB_WWW_DOMAIN=www.buynsellem.com
API_DOMAIN=api.buynsellem.com
CHAT_DOMAIN=chat.buynsellem.com
DB_DOMAIN=db.buynsellem.com
# Reserved for a future public search route if exposed through Traefik
SEARCH_DOMAIN=search.buynsellem.com

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# NotchPay (boost payments — West Africa)
# Public key = Authorization header pour tous les appels API NotchPay
NOTCHPAY_PUBLIC_KEY=your-notchpay-public-key
NOTCHPAY_BASE_URL=https://api.notchpay.co

# Stripe (optional — enables card payments on web + Apple Pay on iOS)
# Leave blank to disable; system falls back to NotchPay for all platforms
# Publishable key is served at runtime via GET /api/public/config (no rebuild needed)
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Novu (notifications)
NOVU_SECRET_KEY=your-novu-secret-key
NOVU_APPLICATION_IDENTIFIER=your-novu-app-id
NOVU_API_URL=https://api.novu.co
# Optional when you have multiple Expo push integrations in the same Novu environment
NOVU_EXPO_INTEGRATION_IDENTIFIER=

# Web frontend
CHAT_PUBLIC_URL=https://chat.buynsellem.com
PUBLIC_WEB_URL=https://buynsellem.com
NEXT_PUBLIC_WEB_URL=https://buynsellem.com

# Mongo Express (DB admin UI)
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=changeme

# CORS for chat-service
CORS_ORIGIN=https://buynsellem.com,https://www.buynsellem.com

# Chat service — dedicated Payload service account (used for internal API calls)
CHAT_SERVICE_EMAIL=chat-service@buynsellem.com
CHAT_SERVICE_PASSWORD=changeme

# GitHub repo (for prod images)
GITHUB_REPO=your-org/bns-repo

# --- For local / test network (no TLS) ---
# Use: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d
# And override these values in your .env:
#NEXT_PUBLIC_API_URL=http://api.buynsellem.com
#CHAT_PUBLIC_URL=http://chat.buynsellem.com
#PAYLOAD_ALLOWED_ORIGINS=http://buynsellem.com,http://www.buynsellem.com
#CORS_ORIGIN=http://buynsellem.com,http://www.buynsellem.com

# Storage
# Provider: local (default, no extra config) | s3 | azure
STORAGE_PROVIDER=local

# S3 / S3-compatible (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# S3_ENDPOINT=https://...  # optional — MinIO, Supabase Storage, Cloudflare R2, etc.

# Azure Blob Storage (when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_BASEURL=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false
