# BNS — Environment Variables
# Copy to .env and fill in your values.
# Never commit .env to git.

# ─── Images ──────────────────────────────────────────────────────────────────
# Registry prefix for all app images.
# Format: ghcr.io/<github-owner>/<repo-name>
IMAGE_REGISTRY=ghcr.io/your-org/bns-bns-repo

# Tag to deploy. Set by CI/CD automatically.
# Manually: v1.2.3 | dev | latest
IMAGE_TAG=latest

# ─── Domains ─────────────────────────────────────────────────────────────────
API_DOMAIN=api.buynsellem.com
WEB_DOMAIN=buynsellem.com
WEB_WWW_DOMAIN=www.buynsellem.com
CHAT_DOMAIN=chat.buynsellem.com
DB_DOMAIN=db.buynsellem.com

# ─── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_USER=bns
MONGO_PASSWORD=change-me-strong-password
MONGO_DB=bns
# DATABASE_URI=mongodb://bns:password@mongodb:27017/bns?authSource=admin&replicaSet=rs0

# Single-node replica set — required for multi-document transactions.
# Keep MONGO_REPLICA_SET empty until this host has the key file and rs.initiate
# has been run on it; the procedure, the downtime it costs and the rollback are in
# docs/superpowers/plans/2026-09-15-p0-mongo-replica-set-runbook.md.
# Set both lines together: MONGO_REPLICA_SET with an empty MONGO_KEYFILE_PATH
# mounts /dev/null and mongod dies on "permissions are too open". Compose cannot
# express that guard, hence this note.
#   MONGO_REPLICA_SET=rs0
#   MONGO_KEYFILE_PATH=./mongo-keyfile   # key file next to this compose file,
#                                        # openssl rand -base64 756, mode 400, owner 999:999
MONGO_REPLICA_SET=
MONGO_KEYFILE_PATH=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=change-me-redis-password

# ─── Meilisearch ─────────────────────────────────────────────────────────────
MEILI_MASTER_KEY=change-me-meili-master-key
MEILI_ENV=production

# ─── Payload / API ───────────────────────────────────────────────────────────
PAYLOAD_SECRET=change-me-payload-secret-min-32-chars
PAYLOAD_PUBLIC_SERVER_URL=https://api.buynsellem.com
PAYLOAD_ALLOWED_ORIGINS=https://buynsellem.com,https://www.buynsellem.com

# Pino log level for the Payload logger: trace | debug | info | warn | error |
# fatal. Empty leaves Payload at its own default ("info").
LOG_LEVEL=

# ─── Web ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.buynsellem.com
NEXT_PUBLIC_WEB_URL=https://buynsellem.com
PUBLIC_WEB_URL=https://buynsellem.com
CHAT_PUBLIC_URL=https://chat.buynsellem.com

# ─── OAuth — Google ──────────────────────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ─── OAuth — Apple ───────────────────────────────────────────────────────────
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=

# ─── OAuth — Facebook ────────────────────────────────────────────────────────
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# ─── Payments — NotchPay ─────────────────────────────────────────────────────
NOTCHPAY_PUBLIC_KEY=
NOTCHPAY_HASH_KEY=
NOTCHPAY_BASE_URL=https://api.notchpay.co

# ─── Payments — Stripe ───────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Notifications — Novu ────────────────────────────────────────────────────
NOVU_SECRET_KEY=
NOVU_APPLICATION_IDENTIFIER=
NOVU_API_URL=https://api.novu.co
NOVU_EXPO_INTEGRATION_IDENTIFIER=

# ─── Chat service ────────────────────────────────────────────────────────────
CHAT_SERVICE_EMAIL=chat@buynsellem.com
CHAT_SERVICE_PASSWORD=change-me-chat-service-password
CORS_ORIGIN=https://buynsellem.com,https://www.buynsellem.com

# ─── Admin DB UI ─────────────────────────────────────────────────────────────
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=change-me-admin-password

# ─── Storage ─────────────────────────────────────────────────────────────────
# Provider: local (default, no extra config) | s3 | azure
STORAGE_PROVIDER=local

# S3 / S3-compatible (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# S3_ENDPOINT=https://...  # optional — MinIO, Supabase Storage, Cloudflare R2, etc.

# Azure Blob Storage (when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_BASEURL=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false
