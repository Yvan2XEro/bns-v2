{
	// The base config carries `exclude: ["node_modules", "tests"]`, so
	// `check-types` has never type-checked a single spec file. That is why
	// `tests/int/api.int.spec.ts` was the only file whose path alias broke:
	// no alias applies under `tests/`, and it was the only spec using one.
	//
	// This config exists to measure and shrink that gap. It is ADVISORY: it is
	// deliberately not in the pre-commit hook, because the backlog it reports
	// would block every commit until it was empty. The rule is that the count
	// must not rise, and that it comes down as P3 touches these files.
	"extends": "./tsconfig.json",
	"exclude": ["node_modules"],
	// `chat-channel-parity.int.spec.ts` (Task 15) is the first spec to import
	// a `chat-service` module, and every one of those imports its own
	// siblings with an explicit `.ts` extension (Bun/ESM convention there).
	// `moduleResolution: "bundler"` refuses that without this flag — TS5097
	// on every such import, in a package this config never touches directly.
	// `noEmit` is already true, which is the flag's other prerequisite.
	// `order-actions-parity.int.spec.ts` imports `packages/web`'s action table,
	// and web's own modules address each other through its `~/*` alias. The
	// base config knows nothing of it, so every such file reported TS2307 —
	// a path that resolves perfectly in web's own type-check. Declaring the
	// alias here is what keeps the error count honest: the alternative was
	// rewriting web sources to relative paths to suit this config.
	// `paths` is replaced wholesale by `extends`, not merged, so the base
	// config's two entries are repeated.
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"paths": {
			"@/*": ["./src/*"],
			"@payload-config": ["./src/payload.config.ts"],
			"~/*": ["../web/src/*"]
		}
	}
}
