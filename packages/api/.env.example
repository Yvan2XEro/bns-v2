# MongoDB
DATABASE_URI=mongodb://localhost:27017/bns
# Payload only enables transactions when the URI names a replica set, so with the
# plain URI above settlement, the deletion cascade and the migrations run without
# one and a half-failed write stays half-written. To develop the way production
# runs, point this at a single-node replica set instead:
# DATABASE_URI=mongodb://localhost:27017/bns?replicaSet=rs0
# It costs you one: either the compose stack (a replica set out of the box), or,
# without auth:
#   docker run -d -p 27017:27017 mongo:7 --replSet rs0 --bind_ip_all
#   docker exec <container> mongosh --quiet --eval 'rs.initiate({ _id: "rs0", members: [{ _id: 0, host: "localhost:27017" }] })'
# A standalone mongod will refuse the replicaSet URI, so keep the two in step.

# Payload CMS
PAYLOAD_SECRET=your-secret-key-here
# HMAC key for phone/device risk subject identifiers. Generate with
# `openssl rand -hex 32`; required before enabling P9 risk signals on these subjects.
RISK_HASH_SECRET=
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_ALLOWED_ORIGINS=http://localhost:3001

# Meilisearch
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=your-meilisearch-master-key

# Redis
REDIS_URL=redis://localhost:6379

# URL du frontend web (pour les redirections après paiement)
PUBLIC_WEB_URL=http://localhost:3001
# Photon geocoder handed to web and mobile by /api/public/config.
PHOTON_URL=https://photon.overbrand.net

# Error reporting and analytics — set on the API only. GET /api/public/config
# hands web and mobile their send-only keys (a Sentry DSN and a PostHog project
# key cannot read anything); the apps send through /api/relay/*. Leave empty to
# turn either off. Account tokens (Sentry auth token, PostHog personal API key)
# never go here.
# One DSN for everything, or one per app (the app ones fall back to SENTRY_DSN).
SENTRY_DSN=
SENTRY_WEB_DSN=
SENTRY_MOBILE_DSN=
SENTRY_ENVIRONMENT=production
# Share of page loads traced for performance, 0–1 (0 keeps to errors only).
SENTRY_TRACES_SAMPLE_RATE=0
# PostHog project key (phc_…) and region host (EU: https://eu.i.posthog.com).
POSTHOG_PROJECT_KEY=
POSTHOG_HOST=https://eu.i.posthog.com

# NotchPay (West Africa mobile money)
# Public key = Authorization header pour tous les appels API NotchPay
NOTCHPAY_PUBLIC_KEY=your-notchpay-public-key
NOTCHPAY_BASE_URL=https://api.notchpay.co

# Stripe (optional — enables card payments on web + Apple Pay on iOS)
# Publishable key is served to clients via GET /api/public/config
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Novu (notifications)
NOVU_SECRET_KEY=your-novu-secret-key
NOVU_APPLICATION_IDENTIFIER=your-novu-app-id
# Novu Cloud by default. Self-hosted: your instance's API and WebSocket
# service (e.g. https://novu-api.example.com, https://novu-ws.example.com);
# the API, the website's inbox and the app (via /api/public/config) use both.
NOVU_API_URL=https://api.novu.co
NOVU_SOCKET_URL=
# Optional — only needed when you have multiple Expo push integrations in the same Novu environment
NOVU_EXPO_INTEGRATION_IDENTIFIER=

# OAuth providers
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
APPLE_OAUTH_CLIENT_ID=
APPLE_OAUTH_TEAM_ID=
APPLE_OAUTH_KEY_ID=
APPLE_OAUTH_PRIVATE_KEY=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=

# Overbrand's single sign-on to the Payload panel, for system administrators
# (Logto, OpenID Connect). Off until the client id and secret are set; every
# other value defaults to Overbrand's provider and may be overridden. Register
# <api>/api/public/auth/sso/callback as the redirect URI.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_ISSUER=https://auth.overbrand.net/oidc
# OIDC_AUTHORIZATION_ENDPOINT=https://auth.overbrand.net/oidc/auth
# OIDC_TOKEN_ENDPOINT=https://auth.overbrand.net/oidc/token
# OIDC_USERINFO_ENDPOINT=https://auth.overbrand.net/oidc/me
# OIDC_JWKS_URI=https://auth.overbrand.net/oidc/jwks
# OIDC_REQUIRED_ROLE=bunSellemAdmin
# OIDC_SCOPES=openid profile email roles
# OIDC_LABEL=Overbrand
# OIDC_ICON=/sso/overbrand.png

# Storage
# Provider: local (default, no extra config) | s3 | azure
STORAGE_PROVIDER=local

# S3 / S3-compatible (when STORAGE_PROVIDER=s3)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
# S3_ENDPOINT=https://...  # optional — MinIO, Supabase Storage, Cloudflare R2, etc.

# Azure Blob Storage (when STORAGE_PROVIDER=azure)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_BASEURL=
AZURE_STORAGE_CONTAINER_NAME=
AZURE_STORAGE_ALLOW_CONTAINER_CREATE=false

# Private storage for identity documents (P2 verification) — must be a
# different bucket/container than the public media one above, or a document
# would be served from the public path. Read only under STORAGE_PROVIDER=s3
# or =azure respectively; local storage uses PRIVATE_UPLOADS_DIR on disk.
S3_PRIVATE_BUCKET=
AZURE_STORAGE_PRIVATE_CONTAINER_NAME=
PRIVATE_UPLOADS_DIR=private-uploads/verification

# Identity & business verification (P2) — Didit KYC
# VERIFICATION_HASH_PEPPER keys the document-number and reviewer-IP hashes.
# Required: with it empty, the API refuses to hash (fails closed) and both
# opening a document and processing a KYC webhook stop working. Rotating it
# orphans every existing hash, so duplicate detection restarts from that point.
VERIFICATION_HASH_PEPPER=changeme-verification-hash-pepper
# Staging only — lets verification be enabled before the legal authorisation
# is recorded. No effect when NODE_ENV=production (hardcoded in the API
# Dockerfile), so this is safe to leave as-is anywhere else.
VERIFICATION_ALLOW_UNAUTHORISED=false
# Leave blank to disable identity verification (Didit); the rest of the app
# still works without it. Only needed to exercise the KYC flow end to end.
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
DIDIT_WORKFLOW_ID=
DIDIT_BASE_URL=https://verification.didit.me
