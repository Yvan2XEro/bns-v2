{
	"expo": {
		"name": "BuyNSellem",
		"slug": "buynsellem",
		"version": "1.0.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "buynsellem",
		"userInterfaceStyle": "automatic",
		"newArchEnabled": true,
		"ios": {
			"supportsTablet": true,
			"bundleIdentifier": "com.buynsellem.mobile",
			"config": {
				"usesNonExemptEncryption": false
			}
		},
		"android": {
			"adaptiveIcon": {
				"backgroundColor": "#E6F4FE",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"backgroundImage": "./assets/images/android-icon-background.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"edgeToEdgeEnabled": true,
			"predictiveBackGestureEnabled": false,
			"package": "com.buynsellem.mobile"
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200,
					"resizeMode": "contain",
					"backgroundColor": "#ffffff",
					"dark": {
						"backgroundColor": "#000000"
					}
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow BuyNSellem to access your photos so you can upload listing and profile images.",
					"cameraPermission": "Allow BuyNSellem to access your camera so you can take photos for your listings."
				}
			],
			[
				"expo-location",
				{
					"locationWhenInUsePermission": "Allow BuyNSellem to access your location to show nearby listings and improve local search."
				}
			],
			[
				"expo-notifications",
				{
					"color": "#1e40af",
					"defaultChannel": "default"
				}
			],
			"expo-localization",
			"expo-secure-store"
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": false
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "c5bebedf-e500-4243-8386-85cf6d62d233"
			}
		},
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/c5bebedf-e500-4243-8386-85cf6d62d233"
		}
	}
}
