# Redis (used for pub/sub adapter + caching)
REDIS_URL=redis://default:changeme@localhost:6379

# Payload CMS API base URL
PAYLOAD_API_URL=http://localhost:3000/api

# Service account credentials (dedicated Payload user for internal calls)
CHAT_SERVICE_EMAIL=chat-service@buynsellem.com
CHAT_SERVICE_PASSWORD=changeme

# Port to listen on
PORT=4000

# CORS allowed origins (comma-separated)
CORS_ORIGIN=http://localhost:3001,https://buynsellem.com
